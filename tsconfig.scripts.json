{
  // Build scripts and config files, which stay JavaScript. Checked loosely: plain JS has no annotations,
  // so implicit `any` is allowed here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/scripts.tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2021"],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.js",
    "scripts/**/*.cjs",
    "scripts/**/*.d.cts",
    "forge.config.js",
    "postcss.config.js",
    "eslint.config.mjs",
    "vite.*.mjs"
  ]
}
