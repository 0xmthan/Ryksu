{
  // Tests run in Node but load code from both sides, so they get both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/test.tsbuildinfo",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "tests/**/*",
    "src/**/*.d.ts",
    // Module augmentations for mineflayer and prismarine (Bot and Entity fields).
    "src/main/bot/types.ts",
    "src/main/bot/vendor/types.ts"
  ]
}
